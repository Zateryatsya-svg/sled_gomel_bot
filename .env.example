# Скопируйте этот файл в .env и впишите свои значения.
# .env никогда не коммитьте в git — он в .gitignore.

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram user_id организатора(ов), через запятую — получают заявки на
# оплату и доступ к /gencode, /codestats, /revoke. Узнать свой id можно
# у @userinfobot.
ADMIN_IDS=

# Необязательно: путь к файлу базы SQLite. Если не задано — используется
# quest_progress.db рядом с кодом. На Amvera нужно поставить
# /data/quest_progress.db (постоянное хранилище, см. README).
DB_PATH=

# Необязательно: дублирование заявок на оплату в WhatsApp через CallMeBot
# (бесплатно). Если не заданы — дублирование просто не отправляется,
# работает только Telegram. Номер — в международном формате, без "+",
# как в ответе бота при активации (например 375251112233). Реальные
# значения впишите только в Railway — не в этот файл, он публичный в репо.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
